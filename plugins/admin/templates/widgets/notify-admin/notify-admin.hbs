{{#extend "widget"}}
{{#content "widget"}}
<frame pos="0 0" id="notify-admin">
  <quad pos="0 0" z-index="0" size="36 8" bgcolor="{{ @theme.quad.foreground }}"/>
  <quad pos="0 -8" z-index="0" size="36 0.5" bgcolor="{{ @theme.quad.background }}"/>
  <label pos="18 -3.75" z-index="0" size="36 8" text="Notify Admin" halign="center" valign="center" textsize="2" textcolor="{{ @theme.label.background }}" textfont="GameFontSemiBold"/>

  <quad pos="0 0" size="36 8.5" z-index="-2" scriptevents="1" bgcolor="{{ @theme.quad.foreground }}" opacity="0" action="{{action data.notifyAdminAction}}" />
</frame>
{{/content}}
{{/extend}}