{{#extend "widget"}}
{{#content "widget"}}
<frame pos="0 0" id="map">
  <quad pos="0 0" z-index="0" size="10 10" bgcolor="{{ @theme.quad.background }}"/>
  <quad pos="10 0" z-index="0" size="45 10" bgcolor="{{ @theme.quad.foreground }}"/>
  <label pos="5 -4.75" z-index="0" size="10 10" text="" halign="center" valign="center" textsize="2.5" textcolor="{{ @theme.label.foreground }}" textfont="GameFontRegular"/>
  <label pos="12 -5.25" z-index="0" size="41 5" text="-" textcolor="{{ @theme.label.background }}" textsize="1.75" textfont="GameFontSemiBold" valign="bottom"/>
  <label pos="11.75 -5.5" z-index="0" size="41 5" text="-" textcolor="{{ @theme.label.background }}" textprefix="$i" textfont="GameFontRegular" valign="top" textsize="1"/>
</frame>
{{/content}}


{{#content "globals"}}
#Struct Map {
  Text name;
  Text author;
}
{{/content}}

{{#content "script"}}
Void updateWidget(Map mapInfo) {
  declare mapFrame <=> (Page.MainFrame.GetFirstChild("map") as CMlFrame);

  (mapFrame.Controls[3] as CMlLabel).SetText(mapInfo.name);
  (mapFrame.Controls[4] as CMlLabel).SetText(mapInfo.author);
}
{{/content}}

{{#content "main"}}
declare Map MapInfo for This;
declare Integer LastMapInfoUpdate for This = -1;
declare Integer lastUpdate = -1;
{{/content}}


{{#content "loop"}}
if (LastMapInfoUpdate != lastUpdate) {
  lastUpdate = LastMapInfoUpdate;
  updateWidget(MapInfo);
}
{{/content}}
{{/extend}}